[Unit]
Description=LLM Bridge coordinator
Documentation=file:///usr/share/doc/bridge-coordinator/install.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bridge
Group=bridge
# /var/lib/bridge-coordinator, owned by the service user, mode 0700.
StateDirectory=bridge-coordinator
StateDirectoryMode=0700
UMask=0077
Environment=BRIDGE_COORDINATOR_DATA_DIR=/var/lib/bridge-coordinator
ExecStart=/usr/local/bin/bridge-coordinator serve
Restart=on-failure
RestartSec=3
# SIGTERM drains connections for up to 10 s; allow a margin before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=20

# Memory: release-build RSS measured on x86-64 is about 6 MiB idle and about 30 MiB with 10000 stored events
# (docs/distributed/benchmarks.md). MemoryMax leaves room for Argon2id (19 MiB per login).
MemoryHigh=192M
MemoryMax=256M
TasksMax=128

# Hardening. The service only needs its state directory and TCP sockets.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No capabilities. To listen on a port below 1024 instead of 8443, add a drop-in
# (systemctl edit bridge-coordinator) with
#   [Service]
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
