[Unit]
Description=LLM Bridge coordinator
Documentation=file:///usr/share/doc/bridge-coordinator/install.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bridge
Group=bridge
# /var/lib/bridge-coordinator, owned by the service user, mode 0700.
StateDirectory=bridge-coordinator
StateDirectoryMode=0700
UMask=0077
Environment=BRIDGE_COORDINATOR_DATA_DIR=/var/lib/bridge-coordinator
ExecStart=/usr/local/bin/bridge-coordinator serve
Restart=on-failure
RestartSec=3
# SIGTERM drains connections for up to 10 s; allow a margin before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=20

# Memory: peak RSS measured on x86-64 is about 48 MiB (two concurrent Argon2id logins at 19 MiB each,
# 200 commands, 1500 events; docs/distributed/benchmarks.md). Same limit as container/compose.yaml.
MemoryHigh=80M
MemoryMax=96M
TasksMax=128

# Hardening. The service only needs its state directory and TCP sockets.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No capabilities. To listen on a port below 1024 instead of 8443, add a drop-in
# (systemctl edit bridge-coordinator) with
#   [Service]
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
